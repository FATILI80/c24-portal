# ============================================================================
# BudgetScout.de — Beispiel-Konfiguration
# ============================================================================
# Diese Datei dient als Vorlage. Für die lokale Entwicklung kopieren nach
# `.env.local` und eigene Werte eintragen. Auf Vercel werden die Variablen
# unter "Project → Settings → Environment Variables" hinterlegt.
# ============================================================================

# ─── CHECK24 Affiliate ─────────────────────────────────────────────────────
NEXT_PUBLIC_CHECK24_PARTNER_ID=deine-partner-id

# ─── Digistore24 Affiliate ─────────────────────────────────────────────────
# Affiliate-Name aus dem Partnerbereich. Ohne Angabe greift im Code der
# Standard "Bb8ozi", damit die Partnerlinks sofort funktionieren.
# Hinweis: redir-Links laufen immer über https://www.checkout-ds24.com/redir/...
# Die Domain www.digistore24.com/redir/... wird von Digistore24 abgelehnt (CUSDM3).
NEXT_PUBLIC_DIGISTORE24_AFFILIATE_ID=Bb8ozi

# ─── Amazon PartnerNet ─────────────────────────────────────────────────────
# Amazon-Partner-Tag. Ohne Angabe greift im Code der Standard-Tag
# "bb8ozi04-21", damit die Partnerlinks sofort funktionieren.
NEXT_PUBLIC_AMAZON_TAG=bb8ozi04-21

# ─── Analytics (optional) ──────────────────────────────────────────────────
# Erst nach Einbau eines Consent-Banners produktiv nutzen.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
